#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix_transform = &default_transform;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <5>;
        rows = <4>;
// Right half matrix - columns 5-9 in the unified matrix
// | SW01  | SW02  | SW03  | SW04  | SW05  |
// | SW06  | SW07  | SW08  | SW09  | SW10  |
// | SW11  | SW12  | SW13  | SW14  | SW15  |
//         | SW16  | SW17  | SW18  |
        map = <
RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9)
RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9)
RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9)
        RC(3,5) RC(3,6) RC(3,7)
        >;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-direct";
        label = "KSCAN";
        input-gpios
        // Right half - 18 keys total (5+5+5+3)
        // Pin layout:
        //  1  3  6 18 21
        //  0  4  7 15 20
        //  2  5  8 14 19
        // 10 16  9 -- --
        
        // Row 0 (Top row) - Right side (5 keys)
        = <&pro_micro 1 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   // Y
        , <&pro_micro 3 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   // U
        , <&pro_micro 6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   // I
        , <&pro_micro 18 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  // O
        , <&pro_micro 21 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  // P

        // Row 1 (Home row) - Right side (5 keys)
        , <&pro_micro 0 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   // H
        , <&pro_micro 4 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   // J
        , <&pro_micro 7 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   // K
        , <&pro_micro 15 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  // L
        , <&pro_micro 20 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  // ;

        // Row 2 (Bottom row) - Right side (5 keys)
        , <&pro_micro 2 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   // N
        , <&pro_micro 5 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   // M
        , <&pro_micro 8 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   // ,
        , <&pro_micro 14 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  // .
        , <&pro_micro 19 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  // /

        // Thumb cluster - Right side (3 keys)
        , <&pro_micro 10 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  // Right thumb 1 (ENT)
        , <&pro_micro 16 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  // Right thumb 2 (RAISE)
        , <&pro_micro 9 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   // Right thumb 3 (ALT)
        ;
    };
};