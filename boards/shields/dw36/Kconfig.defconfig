if SHIELD_DW36_LEFT

config ZMK_KEYBOARD_NAME
    default "DW36"

config ZMK_SPLIT_ROLE_CENTRAL
    default y

endif

if SHIELD_DW36_RIGHT

config ZMK_KEYBOARD_NAME
    default "DW36"

endif

if SHIELD_DW36_LEFT || SHIELD_DW36_RIGHT

config ZMK_SPLIT
    default y

endif