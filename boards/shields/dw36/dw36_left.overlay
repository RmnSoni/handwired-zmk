#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix_transform = &default_transform;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <10>;
        rows = <4>;
// Unified matrix transform for split keyboard
// Left half physical keys map to left side of matrix
// | Q  | W  | E  | R  | T  |                 | Y  | U  | I  | O  | P  |
// | A  | S  | D  | F  | G  |                 | H  | J  | K  | L  | ;  |
// | Z  | X  | C  | V  | B  |                 | N  | M  | ,  | .  | /  |
//             |GUI |LWR |SPC|                 |ENT |RSE |ALT|
        map = <
RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4)  RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9)
RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4)  RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9)
RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4)  RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9)
                RC(3,2) RC(3,3) RC(3,4)  RC(3,5) RC(3,6) RC(3,7)
        >;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-direct";
        label = "KSCAN";
        input-gpios
        // Left half - 18 keys total (5+5+5+3)
        // Pin layout:
        // 21 18  1  3  6  (Q W E R T)
        // 20 15  0  4  7  (A S D F G)
        // 19 14  2  5  8  (Z X C V B)
        // -- -- 10 16  9  (-- -- GUI LOWER SPACE)
        
        // Row 0: Q W E R T (positions RC(0,0) to RC(0,4))
        = <&pro_micro 21 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  // Q - RC(0,0)
        , <&pro_micro 18 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  // W - RC(0,1)
        , <&pro_micro 1 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   // E - RC(0,2)
        , <&pro_micro 3 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   // R - RC(0,3)
        , <&pro_micro 6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   // T - RC(0,4)

        // Row 1: A S D F G (positions RC(1,0) to RC(1,4))
        , <&pro_micro 20 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  // A - RC(1,0)
        , <&pro_micro 15 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  // S - RC(1,1)
        , <&pro_micro 0 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   // D - RC(1,2)
        , <&pro_micro 4 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   // F - RC(1,3)
        , <&pro_micro 7 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   // G - RC(1,4)

        // Row 2: Z X C V B (positions RC(2,0) to RC(2,4))
        , <&pro_micro 19 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  // Z - RC(2,0)
        , <&pro_micro 14 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  // X - RC(2,1)
        , <&pro_micro 2 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   // C - RC(2,2)
        , <&pro_micro 5 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   // V - RC(2,3)
        , <&pro_micro 8 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   // B - RC(2,4)

        // Row 3: GUI LOWER SPACE (positions RC(3,2) to RC(3,4))
        , <&pro_micro 10 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  // GUI - RC(3,2)
        , <&pro_micro 16 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  // LOWER - RC(3,3)
        , <&pro_micro 9 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   // SPACE - RC(3,4)
        ;
    };
};