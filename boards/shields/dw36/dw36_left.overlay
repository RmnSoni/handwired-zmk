#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix_transform = &default_transform;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <10>;
        rows = <4>;
// Left half matrix - columns 0-4 in the unified matrix
// | SW01  | SW02  | SW03  | SW04  | SW05  |
// | SW06  | SW07  | SW08  | SW09  | SW10  |
// | SW11  | SW12  | SW13  | SW14  | SW15  |
//         | SW16  | SW17  | SW18  |
        map = <
RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4)
RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4)
RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4)
        RC(3,2) RC(3,3) RC(3,4)
        >;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-direct";
        label = "KSCAN";
        input-gpios
        // Left half - 18 keys total (5+5+5+3)
        // Pin layout:
        // 21 18  1  3  6
        // 20 15  0  4  7
        // 19 14  2  5  8
        // -- -- 10 16  9
        
        // Row 0 (Top row) - Left side (5 keys)
        = <&pro_micro 21 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  // Q
        , <&pro_micro 18 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  // W
        , <&pro_micro 1 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   // E
        , <&pro_micro 3 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   // R
        , <&pro_micro 6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   // T

        // Row 1 (Home row) - Left side (5 keys)
        , <&pro_micro 20 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  // A
        , <&pro_micro 15 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  // S
        , <&pro_micro 0 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   // D
        , <&pro_micro 4 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   // F
        , <&pro_micro 7 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   // G

        // Row 2 (Bottom row) - Left side (5 keys)
        , <&pro_micro 19 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  // Z
        , <&pro_micro 14 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  // X
        , <&pro_micro 2 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   // C
        , <&pro_micro 5 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   // V
        , <&pro_micro 8 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   // B

        // Thumb cluster - Left side (3 keys)
        , <&pro_micro 10 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  // Left thumb 1 (GUI)
        , <&pro_micro 16 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  // Left thumb 2 (LOWER)
        , <&pro_micro 9 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   // Left thumb 3 (SPACE)
        ;
    };
};